compile_commands.json

# VS Code / Cursor — cấu hình máy cá nhân (COM port, IDF_PATH, ...)
.vscode/
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Cursor
.cursor/

